# Supabase REST API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Supabase Postgres connection string. Get this from Supabase Dashboard > Connect.
# Keep it private; this grants database access.
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres

# Paste the Firebase service-account JSON as a single-line JSON value.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
